{
  "name": "drawflow",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "desktop:dev": "electron . --dev",
    "desktop:start": "npm run build && electron .",
    "desktop:pack": "npm run build && electron-builder --win",
    "cli": "node cli/drawflow.mjs",
    "render": "node cli/drawflow.mjs render",
    "bench": "node cli/drawflow.mjs bench",
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "library:build": "node scripts/library/build.mjs"
  },
  "dependencies": {
    "@ffmpeg/ffmpeg": "0.12.10",
    "@ffmpeg/util": "^0.12.1",
    "fflate": "^0.8.3",
    "gifenc": "^1.0.3",
    "lucide-react": "^0.441.0",
    "mp4-muxer": "^5.2.2",
    "opentype.js": "^1.3.4",
    "pdfjs-dist": "^4.10.38",
    "playwright-core": "^1.63.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "webm-muxer": "^5.1.4",
    "zundo": "^2.1.0",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/opentype.js": "^1.3.8",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.6.3",
    "vite": "^6.0.0"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.zahoor.drawflow",
    "productName": "DrawFlow",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "${productName}-${version}-${os}-${arch}-${target}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "shortcutName": "DrawFlow"
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}"
    }
  },
  "description": "Whiteboard animation studio \u2014 a hand draws pictures and handwriting while a narrator speaks. Local-first, open source.",
  "author": "Zahoor Ishfaq",
  "bin": {
    "drawflow": "./cli/drawflow.mjs"
  },
  "files": [
    "dist/**/*",
    "electron/**/*",
    "cli/**/*",
    "package.json",
    "!node_modules/**/*"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Zahoor-ishfaq/drawflow.git"
  },
  "homepage": "https://github.com/Zahoor-ishfaq/drawflow#readme",
  "bugs": {
    "url": "https://github.com/Zahoor-ishfaq/drawflow/issues"
  },
  "license": "MIT"
}
